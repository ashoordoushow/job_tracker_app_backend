<div id="<%= dom_id job %>">
  <div>
    <strong>Company:</strong>
    <%= job.company %>
  </div>

  <div>
    <strong>Title:</strong>
    <%= job.title %>
  </div>

  <div>
    <strong>Status:</strong>
    <%= job.status %>
  </div>

  <div>
    <strong>Location:</strong>
    <%= job.location %>
  </div>

  <div>
    <strong>Link:</strong>
    <%= job.link %>
  </div>

  <div>
    <strong>Date applied:</strong>
    <%= job.date_applied %>
  </div>

  <div>
    <strong>Notes:</strong>
    <%= job.notes %>
  </div>

</div>
